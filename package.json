{
    "author": "Friedemann Sommer <contact@friedemannsommer.com>",
    "bugs": {
        "url": "https://github.com/friedemannsommer/lcov-parser/issues"
    },
    "description": "A fast, zero-dependency parser for LCOV coverage reports, written in TypeScript for Node.js, with ESM/CommonJS support and a streaming API.",
    "devDependencies": {
        "@arethetypeswrong/core": "0.18.5",
        "@biomejs/biome": "2.5.8",
        "@changesets/changelog-github": "1.0.0",
        "@changesets/cli": "3.0.0",
        "@jazzer.js/core": "4.0.0",
        "@types/node": "24.13.3",
        "c8": "12.0.0",
        "fast-check": "4.9.0",
        "publint": "0.3.23",
        "tinybench": "6.1.3",
        "tsdown": "0.22.14",
        "tsx": "4.23.12",
        "typedoc": "0.28.20",
        "typedoc-github-theme": "0.4.0",
        "typedoc-plugin-mdn-links": "5.1.1",
        "typescript": "6.0.3",
        "unplugin-unused": "0.5.7"
    },
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./constants": {
            "import": {
                "types": "./dist/constants.d.mts",
                "default": "./dist/constants.mjs"
            },
            "require": {
                "types": "./dist/constants.d.cts",
                "default": "./dist/constants.cjs"
            }
        },
        "./lib/field-variant": {
            "import": {
                "types": "./dist/lib/field-variant.d.mts",
                "default": "./dist/lib/field-variant.mjs"
            },
            "require": {
                "types": "./dist/lib/field-variant.d.cts",
                "default": "./dist/lib/field-variant.cjs"
            }
        },
        "./parser": {
            "import": {
                "types": "./dist/parser.d.mts",
                "default": "./dist/parser.mjs"
            },
            "require": {
                "types": "./dist/parser.d.cts",
                "default": "./dist/parser.cjs"
            }
        },
        "./promise": {
            "import": {
                "types": "./dist/promise/index.d.mts",
                "default": "./dist/promise/index.mjs"
            },
            "require": {
                "types": "./dist/promise/index.d.cts",
                "default": "./dist/promise/index.cjs"
            }
        },
        "./stream": {
            "import": {
                "types": "./dist/stream/index.d.mts",
                "default": "./dist/stream/index.mjs"
            },
            "require": {
                "types": "./dist/stream/index.d.cts",
                "default": "./dist/stream/index.cjs"
            }
        },
        "./sync": {
            "import": {
                "types": "./dist/sync/index.d.mts",
                "default": "./dist/sync/index.mjs"
            },
            "require": {
                "types": "./dist/sync/index.d.cts",
                "default": "./dist/sync/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "homepage": "https://friedemannsommer.github.io/lcov-parser/",
    "keywords": [
        "lcov",
        "parse",
        "parser",
        "coverage",
        "code-coverage",
        "test-coverage",
        "typescript",
        "javascript",
        "nodejs",
        "esm",
        "stream",
        "geninfo"
    ],
    "license": "MIT",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "name": "@friedemannsommer/lcov-parser",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/friedemannsommer/lcov-parser.git"
    },
    "scripts": {
        "bench": "npm run build && node --import tsx bench/parse.bench.mts",
        "build": "tsdown",
        "check": "npm run check:biome && npm run check:ts",
        "check:biome": "biome check src bench fuzz",
        "check:ci": "biome ci src bench fuzz && npm run check:ts",
        "check:ts": "tsc --project tsconfig.json --noEmit",
        "coverage": "c8 node --import tsx --test 'src/tests/**/*.spec.ts'",
        "docs": "typedoc",
        "fuzz:parser": "npm run build && jazzer fuzz/parser.fuzz.mjs -i dist/ fuzz/corpus/parser",
        "fuzz:promise": "npm run build && jazzer fuzz/promise.fuzz.mjs -i dist/ fuzz/corpus/promise",
        "fuzz:regression": "npm run build && jazzer fuzz/parser.fuzz.mjs --mode=regression -i dist/ fuzz/corpus/parser && jazzer fuzz/promise.fuzz.mjs --mode=regression -i dist/ fuzz/corpus/promise && jazzer fuzz/stream.fuzz.mjs --mode=regression -i dist/ fuzz/corpus/stream && jazzer fuzz/sync.fuzz.mjs --mode=regression -i dist/ fuzz/corpus/sync",
        "fuzz:stream": "npm run build && jazzer fuzz/stream.fuzz.mjs -i dist/ fuzz/corpus/stream",
        "fuzz:sync": "npm run build && jazzer fuzz/sync.fuzz.mjs -i dist/ fuzz/corpus/sync",
        "release": "npm run build && changeset publish",
        "test": "node --import tsx --test 'src/tests/**/*.spec.ts'"
    },
    "sideEffects": false,
    "type": "module",
    "types": "./dist/index.d.mts",
    "version": "8.0.0",
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
